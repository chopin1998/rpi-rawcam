# systemd *user* unit for rawcamd. deploy.sh substitutes @REPO_ROOT@ and installs it to
# ~/.config/systemd/user/rawcam.service. Manage with: systemctl --user {status|restart|stop} rawcam
[Unit]
Description=RAW Camera Streaming Service (rawcamd)

[Service]
Type=exec
ExecStartPre=:"@REPO_ROOT@/server/wait-camera.sh" 60
ExecStart=:"@REPO_ROOT@/server/bin/rawcamd" --ctrl-port 5600 --stream-port 5601 --snap-port 5602
TimeoutStartSec=75
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
