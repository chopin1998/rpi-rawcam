+static int mvcam_get_mbus_config(struct v4l2_subdev *sd, unsigned int pad,
+				 struct v4l2_mbus_config *cfg)
+{
+	struct mvcam *cam = to_mvcam(sd);
+	u32 kbps;
+	int ret;
+
+	if (pad != IMAGE_PAD)
+		return -EINVAL;
+	ret = mvcam_read(cam->client, MIPI_DataRate, &kbps);
+	if (ret)
+		return ret;
+	cfg->type = V4L2_MBUS_CSI2_DPHY;
+	cfg->bus.mipi_csi2.num_data_lanes = cam->lane_num;
+	cfg->link_freq = kbps == U32_MAX ? MVCAM_DEFAULT_LINK_FREQ / 2 : (s64)kbps * 500;
+	return cfg->link_freq ? 0 : -EINVAL;
+}
